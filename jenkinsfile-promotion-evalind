        }
        
    stages{
        
        stage("Select artifact from Nexus-test"){
            steps {
                echo '-------------------------------------------------------'
                echo '             MenuVersion'
                echo '-------------------------------------------------------'
                withCredentials([[$class: 'UsernamePasswordMultiBinding', credentialsId: CREDENCIAL_NEXUS, usernameVariable: 'USER_NAME', passwordVariable: 'PASSWORD']]) 
                {
                    script{
                       output = sh (returnStdout: true, script: "curl -X GET -u '${USER_NAME}:${PASSWORD}' '${NEXUS_URL}/service/rest/v1/search?repository=${URL_NEXUS_MEBA_TEST}&group=/${NEXUS_GROUP}&direction=desc&sort=name'")                    
                        echo "${output}"
                        def properties = readJSON text: output 
                        VER = properties.items.name.take(8)
                        timeout(time: 360, unit: 'SECONDS') // PASADOS LOS 60' SE CIERRA EL MENU Y SE ABORTA EL PIPELINE 
                        {
                            script{
                                INPUT_PARAMS = input message: 'Seleccion de version', ok: 'Siguiente',
                                parameters: [
                                    choice(name:'VERSIONES_ARTIFACT', choices: VER, description: 'Versiones disponibles')
                                ]
                                env.VERSION_SELECCIONADA = "${INPUT_PARAMS}"
                                echo "'${VERSION_SELECCIONADA}'"
                                env.FILEZIP = "${VERSION_SELECCIONADA}".split("/")[1]
                                echo "filezip: ${FILEZIP}"
                                env.RELEASE = "${FILEZIP}"
                                
                                sh '''
                                wget ${NEXUS_URL}/repository/${URL_NEXUS_MEBA_TEST}/${NEXUS_GROUP}/${FILEZIP} --user ${USER_NAME} --password ${PASSWORD}
                                pwd
                                ls -las
                                '''
                            }
                        }

                        } //c.script
                    }

                } //c.step
        } //c.stage Pull from nexus

        stage("Promotion to Nexus-Prod"){
            steps {
                echo ' ------------------------------------------------'
                echo ' Promotion artifact from Nexus-Test to Nexus-Prod                        '
                echo ' ------------------------------------------------'
                withCredentials([[$class: 'UsernamePasswordMultiBinding', credentialsId: CREDENCIAL_NEXUS, usernameVariable: 'USER_NAME', passwordVariable: 'PASSWORD']]) 
                {
                    script{
                         env.NEXUS_TARGET="${NEXUS_URL}/repository/${URL_NEXUS_MEBA_PROD}/${NEXUS_GROUP}/${FILEZIP}"
                        sh '''
                            curl --fail -u "${USER_NAME}:${PASSWORD}" --upload-file "${FILEZIP}" "${NEXUS_TARGET}"
                            '''
                        echo "promoción de artefacto en nexus-prod realizada"
                    }
            }

         }
        } //c.stage promotion
        
    }
    post {
        always {
